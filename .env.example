# Copy this file to .env and replace every placeholder before starting.
# Do not commit .env.

MYSQL_ROOT_PASSWORD=replace-with-a-root-password
DB_PASSWORD=replace-with-the-rasoi-db-password
DB_USERNAME=rasoi
DB_URL=jdbc:mysql://localhost:3306/food_delivery

JWT_SECRET=replace-with-at-least-32-bytes
JWT_EXPIRATION_MS=28800000

ADMIN_EMAIL=admin@fooddelivery.com
ADMIN_PASSWORD=replace-with-an-admin-password
ADMIN_NAME=Admin Rao
ADMIN_PHONE=

DEMO_USER_PASSWORD=replace-with-a-customer-password
APP_DEMO_SEED=false

API_PORT=8091
WEB_PORT=5178
SERVER_PORT=8080
